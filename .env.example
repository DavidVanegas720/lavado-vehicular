# Variables de entorno del frontend (Vite las lee desde la raíz: envDir "../..").
# Copiar a .env para uso local. Nunca poner secretos reales aquí.

# DSN de Sentry. Vacío = modo consola (errores a console.error). Es público por diseño en el navegador.
VITE_SENTRY_DSN=

# Tasa de errores simulados por los mocks, entre 0 y 1 (0 = ninguno, 0.05 = 5 %).
VITE_MOCK_ERROR_RATE=0

# Latencia simulada de los mocks, en milisegundos (mínimo y máximo).
VITE_MOCK_LATENCIA_MIN_MS=100
VITE_MOCK_LATENCIA_MAX_MS=300

# Modo de cada módulo de la API: "mock" (datos en memoria) o "http" (backend real, desde F2).
VITE_API_MODO_AUTH=mock
VITE_API_MODO_USUARIOS=mock
VITE_API_MODO_TRABAJADORES=mock
VITE_API_MODO_CATALOGO=mock
VITE_API_MODO_ORDENES=mock
VITE_API_MODO_REPORTES=mock
VITE_API_MODO_CIERRE_CAJA=mock
